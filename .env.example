# ---------------------------------------------------------------------------
# RepoPilot AI — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Allowlist (required for real use): comma-separated Telegram numeric user IDs
# allowed to use the bot. Everyone else is denied.
# Tip: leave blank, start the bot, message it — it replies with YOUR numeric ID.
TELEGRAM_ADMIN_IDS=

# --- GitHub (required) -----------------------------------------------------
# A GitHub token. It is used for THREE things:
#   1. Reading source code via the GitHub REST API (crash analysis).
#   2. Cloning / pushing repositories via the git CLI.
#   3. As the LLM API key for GitHub Models (free) — see AI_* below.
#
# Scopes:
#   * Crash analysis of a PUBLIC repo only needs read (public_repo).
#   * Creating branches/commits/PULL REQUESTS needs `repo` (write) scope.
#     Without write scope, /approve (push + PR) will fail with a 403.
GITHUB_TOKEN=

# --- LLM (crash analysis + hosted reasoning) -------------------------------
# OpenAI-compatible endpoint. Defaults to free GitHub Models (uses GITHUB_TOKEN).
AI_BASE_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o-mini

# --- Coding agents ---------------------------------------------------------
# Default CLI coding agent: "claude" or "codex".
DEFAULT_AGENT=claude
# Override CLI paths if they aren't on PATH.
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex
# Optional Claude model alias (e.g. "sonnet", "opus"); empty = CLI default.
CLAUDE_MODEL=
# Claude permission mode for write tasks (acceptEdits applies edits
# non-interactively). Set CLAUDE_SKIP_PERMISSIONS=true only for a trusted
# sandbox to bypass all prompts.
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_SKIP_PERMISSIONS=false

# --- Execution / safety ----------------------------------------------------
# Where repos are cloned (defaults to ./workspace).
# WORKSPACE_DIR=
# SQLite database URL (defaults to ./repopilot.db).
# DATABASE_URL=
# Hard cap (seconds) for a single coding/build task.
TASK_TIMEOUT_SECONDS=1800
# Run repository build/test commands inside Docker (isolated). Requires docker.
# Falls back to local execution (less isolated) if false or docker is missing.
USE_DOCKER=false
