# ---------------------------------------------------------------------------
# CrashFix AI — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Admin allowlist (required for real use): comma-separated Telegram numeric
# user IDs that are allowed to use the bot. Only these users can run commands
# or submit crashes; everyone else is denied.
# Tip: if you leave this blank, start the bot and message it — it will reply
# with YOUR numeric ID, which you can then paste here. e.g. 123456789,987654321
TELEGRAM_ADMIN_IDS=

# GitHub Personal Access Token (required).
# This token is used for TWO things:
#   1. Reading source code from your repo via the GitHub REST API
#      (Tree API + Contents API). A classic/fine-grained PAT with
#      `repo` read access works; for public repos, `public_repo` is enough.
#   2. As the LLM API key for GitHub Models
#      (https://models.inference.ai.azure.com).
GITHUB_TOKEN=

# LLM provider configuration (GitHub Models, free, uses GITHUB_TOKEN above).
AI_BASE_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o-mini
